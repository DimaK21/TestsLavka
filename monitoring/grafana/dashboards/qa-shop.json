      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "qa-shop-prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(shop_revenue_rub_total{job=\"qa-shop\"}[24h])) or on() vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyRUB",
          "decimals": 0
