{
  "uid": "qa-shop",
  "title": "Лавка · мониторинг магазина",
  "description": "Метрики HTTP API, заказов и состояния каталога учебного магазина.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "qa-shop",
    "prometheus"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Сбор метрик",
      "description": "Prometheus успешно получает /metrics от магазина.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "qa-shop-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "qa-shop-prometheus"
          },
          "refId": "A",
          "expr": "max(up{job=\"qa-shop\"}) or on() vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Недоступен",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Работает",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "title": "HTTP 5xx за 5 мин",
      "description": "Доля ответов 5xx среди запросов API. При отсутствии запросов показывается 0%.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "qa-shop-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "qa-shop-prometheus"
          },
          "refId": "A",
          "expr": "((sum(rate(http_requests_total{job=\"qa-shop\",route=~\"/api/.*|unknown\",status=~\"5..\"}[5m])) or on() vector(0)) / clamp_min((sum(rate(http_requests_total{job=\"qa-shop\",route=~\"/api/.*|unknown\"}[5m])) or on() vector(0)), 1e-9)) * 100",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "title": "Заказы за 24 часа",
      "description": "Оценка прироста счётчика оформленных заказов за скользящие 24 часа.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "qa-shop-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "qa-shop-prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(shop_orders_total{job=\"qa-shop\"}[24h])) or on() vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "title": "Сумма заказов за 24 часа",
      "description": "Сумма оформленных заказов с доставкой. Подтверждение оплаты в метрике не учитывается.",
      "type": "stat",
